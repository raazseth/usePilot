{
  "name": "@usepilot/database",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite database schema, migrations, and repository layer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:seed": "bun run src/seed.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@usepilot/config": "workspace:*",
    "@usepilot/types": "workspace:*",
    "@usepilot/utils": "workspace:*",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@usepilot/typescript-config": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
