{
  "name": "@usepilot/execution-core",
  "version": "0.1.0",
  "private": true,
  "description": "Execution engine for usePilot — CapabilityRegistry, TaskScheduler, ExecutionRunner, ApprovalGate, VerificationEngine, RetryEngine, CheckpointManager, ExecutionJournal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@usepilot/execution-types": "workspace:*",
    "@usepilot/planner-types": "workspace:*",
    "@usepilot/utils": "workspace:*",
    "playwright": "^1.63.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@usepilot/typescript-config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
