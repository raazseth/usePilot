{
  "name": "@usepilot/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Core intelligence and reasoning engine for the usePilot Agent System — Registry, Goal Analyzer, Strategy Selector, Parameterizer, Recovery Controller, Outcome Interpreter, and Agent Orchestrator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@usepilot/agent-types": "workspace:*",
    "@usepilot/skill-types": "workspace:*",
    "@usepilot/skill-core": "workspace:*",
    "@usepilot/planner-types": "workspace:*",
    "@usepilot/planner-core": "workspace:*",
    "@usepilot/execution-types": "workspace:*",
    "@usepilot/execution-core": "workspace:*",
    "@usepilot/runtime-context": "workspace:*",
    "@usepilot/ai-core": "workspace:*",
    "@usepilot/types": "workspace:*",
    "@usepilot/utils": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@usepilot/typescript-config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  }
}
